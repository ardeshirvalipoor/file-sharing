# Copy to .env and fill in. The server refuses to start if any of these are
# missing, apart from PORT and PUBLIC_BASE_URL, which have sensible defaults.

PORT=3000

# The address people reach the service on. Share links are built from it.
PUBLIC_BASE_URL=http://localhost:3000

# Cloudflare R2. Account id is in the R2 page of the Cloudflare dashboard; the
# key pair comes from "Manage R2 API Tokens" with Object Read & Write on this
# one bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Signs upload tokens. Any long random string; changing it invalidates every
# upload that is still in progress.
UPLOAD_TOKEN_SECRET=

# Supabase Postgres. In the dashboard: Connect, then Connection string. Take the
# "Transaction pooler" one on port 6543, which works over IPv4 and suits a
# machine that stops and starts. Put your database password where the URL says
# [YOUR-PASSWORD].
DATABASE_URL=
